# Copy to .env.local and fill in. Both of these are safe in the browser —
# RLS is what protects the data, not secrecy of the anon key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NEVER put the service role key in this file or anywhere Vercel can see it.
# It lives in Supabase edge function secrets only.
